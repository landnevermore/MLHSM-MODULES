{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/landnevermore/MLHSM-MODULES/main/schema/manifest.schema.json",
  "title": "MLHSM module manifest",
  "description": "One module. This schema describes the registry manifest consumed by MLHSM. Installable artifact fields intentionally match hsm-core's RegistryRelease type.",
  "type": "object",
  "required": ["id", "name", "description", "author", "version"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "minLength": 2, "maxLength": 64 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "author": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "$ref": "#/$defs/semver" },
    "icon": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+\\.(png|svg|webp)$" },
    "category": { "type": "string", "maxLength": 50 },
    "origin": { "type": "string", "enum": ["internal", "external"], "default": "internal" },
    "entry": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1, "maxLength": 100 },
        "args": { "type": "array", "items": { "type": "string", "maxLength": 500 } },
        "protocol": { "type": "string", "enum": ["http"], "default": "http" },
        "health_path": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]*$", "default": "/health" },
        "prefer_arg_port": { "type": "boolean", "default": false }
      }
    },
    "mlhsm": {
      "type": "object",
      "required": ["min_version"],
      "additionalProperties": false,
      "properties": {
        "min_version": { "$ref": "#/$defs/semver" },
        "max_version": { "$ref": "#/$defs/semver" },
        "api": { "type": "string", "pattern": "^mlhsm-module/[0-9]+$" }
      }
    },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
    "optional_dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
    "permissions": { "type": "array", "items": { "$ref": "#/$defs/permission" } },
    "provides": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 50 } },
    "owned_paths": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" } },
    "database_tables": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" } },
    "route_prefixes": { "type": "array", "items": { "type": "string", "pattern": "^/api/v[0-9]+/[A-Za-z0-9/_-]+$" } },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": { "type": "array", "items": { "type": "string", "enum": ["linux", "windows", "macos"] }, "minItems": 1 },
        "arch": { "type": "array", "items": { "type": "string", "enum": ["x86_64", "aarch64", "arm64"] }, "minItems": 1 }
      }
    },
    "architecture": { "type": "string", "maxLength": 50 },
    "canvas_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "title", "slot", "order"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "slot": { "type": "string", "enum": ["main", "sidebar", "footer"] },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "artifact": {
      "description": "Installable release metadata consumed by MLHSM's RegistryRelease type. A missing artifact means metadata-only and is not installable.",
      "type": "object",
      "required": ["tag"],
      "additionalProperties": false,
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "asset": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "required": ["url"] },
          "then": { "required": ["sha256", "size", "asset"] }
        }
      ]
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "dependency": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "version": { "$ref": "#/$defs/semver" },
        "optional": { "type": "boolean", "default": false }
      }
    },
    "permission": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "enum": ["docker", "network", "filesystem", "credentials", "notifications", "system"] },
        "description": { "type": "string", "maxLength": 300 },
        "required": { "type": "boolean", "default": true }
      }
    }
  }
}
